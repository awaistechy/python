#Class Task 4 - Print odd numbers from 1 to 10, using continue. [using while]
i = 0
while i < 10:
  i += 1
  if i % 2 == 0:
    continue;
  print(i)


#Class Task 5 - Count vowels in a word. [using for]
word = "Muhammad Awais Asif"
count = 0
for ch in word.lower():
  if ch == "a" or ch == "e" or ch == "i" or ch == "o" or ch == "u":
    count += 1
print(f"Sting contain {count} Vowels")


#Class Task 6 - Sum of first n natural numbers. [using for]



#Class Task 7 - Create a function to compute factorial of a number n.
def factorial(n):
  if n <=0:
    return 1
  else:
    return n * (factorial(n-1))

factorial(6)
